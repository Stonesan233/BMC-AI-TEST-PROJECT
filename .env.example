# ======================================================================
# openUBMC AI 测试框架 - 环境变量配置示例
#
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ======================================================================

# ---- Judge LLM (Qwen3-235B-A22B 或 72B) ----
# 阿里百炼 DashScope
QWEN3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN3_API_KEY=sk-your-api-key-here
QWEN3_MODEL=qwen3-235b-a22b
QWEN3_TEMPERATURE=0.0
QWEN3_MAX_TOKENS=8192

# ---- Judge LLM 备选 (GLM-5) ----
# 智谱 GLM
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_API_KEY=your-glm-api-key
# GLM_MODEL=glm-5
# GLM_TEMPERATURE=0.0
# GLM_MAX_TOKENS=8192

# ---- Exec LLM (MiniMax-M2.5) ----
MINIMAX_API_KEY=your-minimax-api-key

# ---- RAG Embedding (DashScope text-embedding-v4) ----
DASHSCOPE_API_KEY=your-dashscope-embedding-key
